#!/bin/bash

{{/* Build the Brewfile content first */}}
{{- $brewfile := "" -}}

{{/* Add Darwin-specific packages */}}
{{- if eq .chezmoi.os "darwin" -}}
  {{- range .packages.darwin.taps -}}
    {{- $brewfile = print $brewfile "tap " (. | quote) "\n" -}}
  {{- end -}}
  {{- range .packages.darwin.brews -}}
    {{- $brewfile = print $brewfile "brew " (. | quote) "\n" -}}
  {{- end -}}
  {{- range .packages.darwin.casks -}}
    {{- $brewfile = print $brewfile "cask " (. | quote) "\n" -}}
  {{- end -}}
  {{- range .packages.darwin.mas -}}
    {{- $brewfile = print $brewfile "mas " (.name | quote) ", id: " .id "\n" -}}
  {{- end -}}
{{- end -}}

{{/* Add common packages */}}
{{- range .packages.common.taps -}}
  {{- $brewfile = print $brewfile "tap " (. | quote) "\n" -}}
{{- end -}}
{{- range .packages.common.brews -}}
  {{- $brewfile = print $brewfile "brew " (. | quote) "\n" -}}
{{- end -}}


{{/* Trust every tap we declare before bundling (Homebrew Tap Trust); official taps are always-trusted no-ops */}}
{{- range .packages.darwin.taps }}
brew trust --tap {{ . | quote }}
{{- end }}
{{- range .packages.common.taps }}
brew trust --tap {{ . | quote }}
{{- end }}
echo "📦  Installing packages..."

brew bundle --file=/dev/stdin <<EOF
{{ $brewfile }}
EOF

{{- if eq .chezmoi.os "darwin" }}
# Docker Desktop-free CLI setup (colima + docker + compose/buildx plugins)
mkdir -p ~/.docker
[ -f ~/.docker/config.json ] || echo '{}' > ~/.docker/config.json
jq '.cliPluginsExtraDirs = ((.cliPluginsExtraDirs // []) + ["/opt/homebrew/lib/docker/cli-plugins"] | unique)
    | .credsStore = (.credsStore // "osxkeychain")' \
  ~/.docker/config.json > ~/.docker/config.json.tmp && mv ~/.docker/config.json.tmp ~/.docker/config.json
{{- end }}
